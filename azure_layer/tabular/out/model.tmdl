/// Tabular model generated by azure_layer.tabular.model
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3

	table Sales
		column amount_cents
			dataType: int64
			summarizeBy: sum
		column quantity
			dataType: int64
			summarizeBy: sum

	table Products
		column price_cents
			dataType: int64
			summarizeBy: sum
		column stock_count
			dataType: int64
			summarizeBy: sum

	table _Measures
		measure "Total Revenue" = SUM(Sales[amount_cents])
			formatString: 0
		measure "Total Events" = COUNTROWS(Sales)
			formatString: 0
		measure "Avg Price" = AVERAGE(Products[price_cents])
			formatString: 0
		measure "Inventory Value" = SUMX(Products, Products[price_cents] * Products[stock_count])
			formatString: 0
		measure "Revenue per Event" = DIVIDE([Total Revenue], [Total Events])
			formatString: 0
		measure "Books Revenue" = CALCULATE([Total Revenue], Sales[category] = ""books"")
			formatString: 0
		measure "Revenue per Product" = DIVIDE([Total Revenue], COUNTROWS(Products))
			formatString: 0
		measure "Max Inventory Product" = MAX(Products[stock_count])
			formatString: 0
